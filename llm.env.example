# Loki Code Configuration File
# Choose your API type: ollama, openai, or openai-compatible

# ===== OLLAMA CONFIGURATION (Default) =====
# Uncomment these lines for Ollama usage
API_TYPE=ollama
BASE_URL=http://localhost:11434
MODEL_NAME=qwen3:32b

# ===== OPENAI CONFIGURATION =====
# Uncomment these lines for OpenAI usage
# API_TYPE=openai
# BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-3.5-turbo
# BEARER_TOKEN=your_openai_api_key_here

# ===== OPENAI-COMPATIBLE API CONFIGURATION =====
# Example: LocalMind API (as provided by user)
# Uncomment and modify these lines for OpenAI-compatible APIs
# API_TYPE=openai-compatible
# BASE_URL=https://IHRE_INSTANZ.localmind.io/localmind/public-chat
# MODEL_NAME=localmind-ultra
# BEARER_TOKEN=IHR_API_KEY

# ===== OTHER OPENAI-COMPATIBLE EXAMPLES =====
# Example: Anthropic Claude (via proxy)
# API_TYPE=openai-compatible
# BASE_URL=https://api.anthropic.com/v1
# MODEL_NAME=claude-3-sonnet-20240229
# BEARER_TOKEN=your_anthropic_api_key

# Example: Local LLM with OpenAI-compatible API
# API_TYPE=openai-compatible
# BASE_URL=http://localhost:8000/v1
# MODEL_NAME=your-local-model
# BEARER_TOKEN=your_local_api_key

# ===== OPTIONAL SETTINGS =====
# Enable debug mode for detailed logging
# DEBUG=false

# Notes:
# - Only set one API_TYPE at a time
# - Bearer tokens are required for OpenAI and OpenAI-compatible APIs
# - For Ollama, no authentication is typically required
# - Environment variables (LOKI_*) will override these settings
# - Command line flags will override both file and environment settings